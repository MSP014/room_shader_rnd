#usda 1.0
(
    customLayerData = {
        string "orms:fixtureOrigin" = "Omniverse capture layer over Houdini-authored geometry"
        string "orms:houdiniSource" = "hip/room map test 005.hiplc"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World" (
    prepend references = @../test_room_map_apertures_houdini.usda@</World>
)
{
    def DomeLight "KRM93Environment"
    {
        float inputs:exposure = 0
        float inputs:intensity = 1000
        asset inputs:texture:file = @../../assets/_external/hdri/kloofendal_48d_partly_cloudy_puresky_4k.exr@
        token inputs:texture:format = "latlong"
        float xformOp:rotateX = -90
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }

    over "HoudiniGrid"
    {
        over "geo"
        {
            over "windows"
            {
                int[] primvars:roomID = [
                    11, 11, 12, 13, 13,
                    21, 21, 21, 22, 23,
                    31, 31, 31, 31, 32
                ] (
                    interpolation = "uniform"
                )
            }
        }
    }
}
