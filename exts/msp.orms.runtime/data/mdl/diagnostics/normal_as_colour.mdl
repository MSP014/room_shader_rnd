mdl 1.7;

// Visualise the MDL shading normal after remapping signed values to colour.

import ::df::*;
import ::state::*;

export material normal_as_colour() = let {
    color diagnostic_colour = color(
        0.5 * state::normal() + float3(0.5, 0.5, 0.5)
    );
} in material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: diagnostic_colour
        ),
        emission: material_emission(
            df::diffuse_edf(),
            intensity: diagnostic_colour
        )
    )
);
