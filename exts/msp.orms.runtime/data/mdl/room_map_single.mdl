mdl 1.7;

// Minimal five-face ORMS reference material. It proves the authored room frame,
// camera bridge, analytic ray-box hit, cross-atlas mapping, and deterministic
// UDIM selection without shared-room or layered-depth complexity.

import ::df::*;
import ::math::*;
import ::state::*;
import ::tex::*;
import ::nvidia::support_definitions::*;

// All ray-plane helpers share one numeric guard and miss sentinel so invalid
// or backward intersections cannot win the nearest-hit selection.
float room_map_epsilon()
{
    return 0.0001;
}

float room_map_far_distance()
{
    return 1000000.0;
}

float saturate(float value)
{
    return math::min(1.0, math::max(0.0, value));
}

// Select luminous atlas pixels from the already sampled linear-sRGB room
// colour. The mask is evaluated before glass tint so art direction cannot
// silently change which authored pixels emit.
float room_emission_mask(
    color source_colour,
    bool enable_emission,
    float emission_threshold,
    float emission_softness
) = let {
    float safe_threshold = saturate(emission_threshold);
    float safe_softness = math::max(emission_softness, 0.0);
    float half_softness = safe_softness * 0.5;
    float lower_threshold = saturate(safe_threshold - half_softness);
    float upper_threshold = math::max(
        lower_threshold + room_map_epsilon(),
        saturate(safe_threshold + half_softness)
    );
    float source_luminance = math::dot(
        float3(source_colour),
        float3(0.2126, 0.7152, 0.0722)
    );
} in !enable_emission
    ? 0.0
    : safe_softness <= room_map_epsilon()
    ? (source_luminance >= safe_threshold ? 1.0 : 0.0)
    : math::smoothstep(
        lower_threshold,
        upper_threshold,
        source_luminance
    );

// Stable integer mixing selects one complete UDIM room for every roomID.
int positive_modulo(int value, int divisor)
{
    int remainder = value % divisor;

    return remainder < 0 ? remainder + divisor : remainder;
}

int select_room_variant(
    int room_id,
    int variation_seed,
    int room_variant_count
)
{
    int safe_variant_count = room_variant_count > 0 ? room_variant_count : 1;
    int mixed_id = room_id * 1664525 + variation_seed * 1013904223;

    return positive_modulo(mixed_id, safe_variant_count);
}

float2 udim_atlas_coordinate(float2 atlas_coordinate, int variant_index)
{
    int safe_variant_index = variant_index > 0 ? variant_index : 0;
    int tile_u = safe_variant_index % 10;
    int tile_v = safe_variant_index / 10;

    return atlas_coordinate + float2(float(tile_u), float(tile_v));
}

// Only positive distances represent visible interior planes.
float positive_plane_distance(
    float plane,
    float origin,
    float direction
) = let {
    float epsilon = room_map_epsilon();
    float safe_direction = direction >= 0.0
        ? math::max(direction, epsilon)
        : math::min(direction, -epsilon);
    float distance = (plane - origin) / safe_direction;
} in distance > epsilon ? distance : room_map_far_distance();

// Resolve the nearest of the five room faces into its labelled 3x3 cross tile.
float2 cross_atlas_coordinate(
    float3 hit_point,
    float room_depth,
    float back_distance,
    float left_distance,
    float right_distance,
    float ceiling_distance,
    float floor_distance
) = let {
    float tile_size = 1.0 / 3.0;
    float depth_coordinate = saturate(-hit_point.z / room_depth);
    float middle_v = tile_size * (1.0 + hit_point.y);
    float middle_u = tile_size * (1.0 + hit_point.x);
} in back_distance <= left_distance
        && back_distance <= right_distance
        && back_distance <= ceiling_distance
        && back_distance <= floor_distance
    ? float2(middle_u, middle_v)
    : left_distance <= right_distance
        && left_distance <= ceiling_distance
        && left_distance <= floor_distance
    ? float2(tile_size * depth_coordinate, middle_v)
    : right_distance <= ceiling_distance
        && right_distance <= floor_distance
    ? float2(tile_size * (3.0 - depth_coordinate), middle_v)
    : ceiling_distance <= floor_distance
    ? float2(middle_u, tile_size * (3.0 - depth_coordinate))
    : float2(middle_u, tile_size * depth_coordinate);

// Public baseline material. Source geometry provides roomP, tangentu, tangentv,
// roomUV, and roomID; the runtime bridge provides the camera world position.
export material room_map_single(
    uniform texture_2d room_atlas = texture_2d(),
    uniform int room_variant_count = 1,
    uniform int variation_seed = 0,
    float3 camera_position_world = float3(0.0),
    float room_depth = 1.0,
    float glass_roughness = 0.1,
    float glass_reflectivity = 0.04,
    color glass_tint = color(1.0),
    float glass_transmission = 1.0,
    color fallback_colour = color(1.0, 0.0, 1.0),
    bool enable_emission = false,
    float emission_strength = 1.0,
    float emission_threshold = 0.8,
    float emission_softness = 0.1
) = let {
    // Read the complete authored geometry contract before constructing a frame.
    float3 room_position_object = nvidia::support_definitions::data_lookup_float3(
        "roomP",
        float3(0.0)
    );
    float3 tangent_u_object = nvidia::support_definitions::data_lookup_float3(
        "tangentu",
        float3(0.0)
    );
    float3 tangent_v_object = nvidia::support_definitions::data_lookup_float3(
        "tangentv",
        float3(0.0)
    );
    float3 bridged_camera_position_world =
        nvidia::support_definitions::data_lookup_float3(
            "ormsCameraPositionWorld",
            camera_position_world
        );
    float3 room_uv = nvidia::support_definitions::data_lookup_float3(
        "roomUV",
        state::texture_coordinate(0)
    );
    int room_id = nvidia::support_definitions::data_lookup_int(
        "roomID",
        0
    );
    int variant_index = select_room_variant(
        room_id,
        variation_seed,
        room_variant_count
    );
    // Transform point and vector primvars according to their geometric roles;
    // applying a point transform to tangent vectors would introduce translation.
    float3 room_position = state::transform_point(
        state::coordinate_object,
        state::coordinate_world,
        room_position_object
    );
    float3 tangent_u_raw = state::transform_vector(
        state::coordinate_object,
        state::coordinate_world,
        tangent_u_object
    );
    float3 tangent_v_raw = state::transform_vector(
        state::coordinate_object,
        state::coordinate_world,
        tangent_v_object
    );
    float tangent_u_extent = math::length(tangent_u_raw);
    float tangent_v_extent = math::length(tangent_v_raw);
    bool frame_is_valid = tangent_u_extent > room_map_epsilon()
        && tangent_v_extent > room_map_epsilon()
        && room_depth > room_map_epsilon();
    float safe_tangent_u_extent = math::max(
        tangent_u_extent,
        room_map_epsilon()
    );
    float safe_tangent_v_extent = math::max(
        tangent_v_extent,
        room_map_epsilon()
    );
    // Degenerate exported frames remain visible through the magenta fallback
    // instead of feeding zero-length axes into the room-space projection.
    float3 tangent_u = frame_is_valid
        ? math::normalize(tangent_u_raw)
        : float3(1.0, 0.0, 0.0);
    float3 tangent_v = frame_is_valid
        ? math::normalize(tangent_v_raw)
        : float3(0.0, 1.0, 0.0);
    float3 room_normal = math::normalize(math::cross(tangent_u, tangent_v));
    float3 surface_position_world = state::transform_point(
        state::coordinate_internal,
        state::coordinate_world,
        state::position()
    );
    // Project camera and surface into the same normalised room frame before the
    // view ray is formed. Tangent magnitudes preserve physical aperture scale.
    float3 camera_from_room = bridged_camera_position_world - room_position;
    float3 surface_from_room = surface_position_world - room_position;
    float3 camera_position_room = float3(
        math::dot(camera_from_room, tangent_u) / safe_tangent_u_extent,
        math::dot(camera_from_room, tangent_v) / safe_tangent_v_extent,
        math::dot(camera_from_room, room_normal)
    );
    float3 surface_position_room = float3(
        math::dot(surface_from_room, tangent_u) / safe_tangent_u_extent,
        math::dot(surface_from_room, tangent_v) / safe_tangent_v_extent,
        math::dot(surface_from_room, room_normal)
    );
    float3 ray_direction = math::normalize(
        surface_position_room - camera_position_room
    );
    float3 ray_origin = float3(
        saturate(room_uv.x),
        saturate(room_uv.y),
        0.0
    );
    // Intersect the ray with Back, Left, Right, Ceiling, and Floor analytically.
    float back_distance = positive_plane_distance(
        -room_depth,
        ray_origin.z,
        ray_direction.z
    );
    float left_distance = positive_plane_distance(
        0.0,
        ray_origin.x,
        ray_direction.x
    );
    float right_distance = positive_plane_distance(
        1.0,
        ray_origin.x,
        ray_direction.x
    );
    float ceiling_distance = positive_plane_distance(
        1.0,
        ray_origin.y,
        ray_direction.y
    );
    float floor_distance = positive_plane_distance(
        0.0,
        ray_origin.y,
        ray_direction.y
    );
    float hit_distance = math::min(
        back_distance,
        math::min(
            left_distance,
            math::min(
                right_distance,
                math::min(ceiling_distance, floor_distance)
            )
        )
    );
    float3 hit_point = ray_origin + hit_distance * ray_direction;
    float2 atlas_coordinate = cross_atlas_coordinate(
        hit_point,
        room_depth,
        back_distance,
        left_distance,
        right_distance,
        ceiling_distance,
        floor_distance
    );
    // The selected face and room variant require exactly one texture lookup.
    float4 atlas_sample = tex::lookup_float4(
        room_atlas,
        udim_atlas_coordinate(atlas_coordinate, variant_index),
        tex::wrap_clip,
        tex::wrap_clip
    );
    color sampled_colour = color(
        atlas_sample.x,
        atlas_sample.y,
        atlas_sample.z
    );
    color room_colour = frame_is_valid ? sampled_colour : fallback_colour;
    // Keep the analytic room visible on its proxy while adding the front-glass
    // response. True refraction would reveal absent geometry behind the quad.
    float safe_glass_roughness = saturate(glass_roughness);
    float squared_glass_roughness =
        safe_glass_roughness * safe_glass_roughness;
    float safe_glass_reflectivity = saturate(glass_reflectivity);
    float safe_glass_transmission = saturate(glass_transmission);
    color tinted_room_colour = room_colour * glass_tint;
    color glass_base_colour =
        glass_tint * (1.0 - safe_glass_transmission)
        + tinted_room_colour * safe_glass_transmission;
    bsdf room_surface = df::diffuse_reflection_bsdf(
        tint: glass_base_colour
    );
    bsdf glass_reflection = df::microfacet_ggx_smith_bsdf(
        roughness_u: squared_glass_roughness,
        roughness_v: squared_glass_roughness,
        tint: color(1.0),
        mode: df::scatter_reflect
    );
    // Roughness controls only the GGX lobe width. Keep its normal-incidence
    // strength explicit so a sharp reflection can be diagnosed independently
    // from tint and artistic transmission.
    bsdf room_behind_glass = df::custom_curve_layer(
        normal_reflectivity: safe_glass_reflectivity,
        grazing_reflectivity: 1.0,
        exponent: 5.0,
        weight: 1.0,
        layer: glass_reflection,
        base: room_surface,
        normal: state::normal()
    );
    // The baseline atlas contains no front-face lookup: every valid colour is
    // sampled from Back, Left, Right, Ceiling, or Floor.
    float luminous_room_mask = frame_is_valid
        ? room_emission_mask(
            room_colour,
            enable_emission,
            emission_threshold,
            emission_softness
        )
        : 0.0;
    color visible_room_emission =
        tinted_room_colour * safe_glass_transmission * luminous_room_mask;
} in material(
    surface: material_surface(
        scattering: room_behind_glass,
        emission: material_emission(
            df::diffuse_edf(),
            intensity: visible_room_emission * emission_strength
        )
    )
);
