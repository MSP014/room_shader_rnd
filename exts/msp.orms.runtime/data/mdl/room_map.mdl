mdl 1.7;

// Production ORMS material for runtime-classified shared rooms. The material
// consumes classifier-authored primvars, traces one analytic room hit, and
// composites four optional depth slices with a bounded five-texture lookup
// budget.

import ::df::*;
import ::math::*;
import ::state::*;
import ::tex::*;
import ::nvidia::support_definitions::*;

// Keep numeric guards and the miss sentinel central so every intersection
// helper follows the same degenerate-input contract.
float room_map_epsilon()
{
    return 0.0001;
}

float room_map_far_distance()
{
    return 1000000.0;
}

float saturate(float value)
{
    return math::min(1.0, math::max(0.0, value));
}

// Select luminous atlas pixels from the already sampled linear-sRGB room
// colour. The mask is evaluated before glass tint so art direction cannot
// silently change which authored pixels emit.
float room_emission_mask(
    color source_colour,
    bool enable_emission,
    float emission_threshold,
    float emission_softness
) = let {
    float safe_threshold = saturate(emission_threshold);
    float safe_softness = math::max(emission_softness, 0.0);
    float half_softness = safe_softness * 0.5;
    float lower_threshold = saturate(safe_threshold - half_softness);
    float upper_threshold = math::max(
        lower_threshold + room_map_epsilon(),
        saturate(safe_threshold + half_softness)
    );
    float source_luminance = math::dot(
        float3(source_colour),
        float3(0.2126, 0.7152, 0.0722)
    );
} in !enable_emission
    ? 0.0
    : safe_softness <= room_map_epsilon()
    ? (source_luminance >= safe_threshold ? 1.0 : 0.0)
    : math::smoothstep(
        lower_threshold,
        upper_threshold,
        source_luminance
    );

// Artist and runtime extents are clamped before they enter divisions or frame
// scaling. Invalid inputs remain renderable and select the documented fallback.
float positive_extent(float value)
{
    return math::max(value, room_map_epsilon());
}

float physical_aperture_cutout_opacity(
    float3 camera_position_world,
    float3 surface_position_world,
    float3 physical_aperture_normal_world
) = let {
    float3 camera_from_surface =
        camera_position_world - surface_position_world;
    float camera_distance = math::length(camera_from_surface);
    float normal_length = math::length(physical_aperture_normal_world);
    bool facing_input_is_valid = camera_distance > room_map_epsilon()
        && normal_length > room_map_epsilon();
    float facing_cosine = facing_input_is_valid
        ? math::dot(
            camera_from_surface / camera_distance,
            physical_aperture_normal_world / normal_length
        )
        : 1.0;
} in !facing_input_is_valid || facing_cosine > room_map_epsilon()
    ? 1.0
    : 0.0;

// The integer mix keeps room variation stable across camera motion, primitive
// order, renderer changes, and reloads. One selected UDIM is reused by all
// room-face and slice samples for the shaded aperture.
int positive_modulo(int value, int divisor)
{
    int remainder = value % divisor;

    return remainder < 0 ? remainder + divisor : remainder;
}

int select_room_variant(
    int room_id,
    int variation_seed,
    int room_variant_count
)
{
    int safe_variant_count = room_variant_count > 0 ? room_variant_count : 1;
    int mixed_id = room_id * 1664525 + variation_seed * 1013904223;

    return positive_modulo(mixed_id, safe_variant_count);
}

float2 udim_atlas_coordinate(float2 atlas_coordinate, int variant_index)
{
    int safe_variant_index = variant_index > 0 ? variant_index : 0;
    int tile_u = safe_variant_index % 10;
    int tile_v = safe_variant_index / 10;

    return atlas_coordinate + float2(float(tile_u), float(tile_v));
}

// Return only forward ray-plane hits. Parallel, backward, and near-zero cases
// use a finite sentinel so the later minimum-distance selection needs no
// exceptional-value handling.
float positive_plane_distance(
    float plane,
    float origin,
    float direction
) = let {
    float epsilon = room_map_epsilon();
    float safe_direction = direction >= 0.0
        ? math::max(direction, epsilon)
        : math::min(direction, -epsilon);
    float distance = (plane - origin) / safe_direction;
} in distance > epsilon ? distance : room_map_far_distance();

// Trace the five closed faces of a room-local box. X and Y start at zero, the
// aperture lies at Z=0, and the virtual interior extends along negative Z.
// The returned XY pair is the selected cross-atlas coordinate; Z is hit distance.
float3 trace_room_cross(
    float3 ray_origin,
    float3 ray_direction,
    float room_width,
    float room_height,
    float room_front_depth,
    float room_depth
) = let {
    float tile_size = 1.0 / 3.0;
    float safe_room_width = positive_extent(room_width);
    float safe_room_height = positive_extent(room_height);
    float safe_room_front_depth = math::max(room_front_depth, 0.0);
    float safe_room_depth = positive_extent(room_depth);
    float safe_total_room_depth =
        safe_room_front_depth + safe_room_depth;
    float back_distance = positive_plane_distance(
        -safe_total_room_depth,
        ray_origin.z,
        ray_direction.z
    );
    float left_distance = positive_plane_distance(
        0.0,
        ray_origin.x,
        ray_direction.x
    );
    float right_distance = positive_plane_distance(
        safe_room_width,
        ray_origin.x,
        ray_direction.x
    );
    float ceiling_distance = positive_plane_distance(
        safe_room_height,
        ray_origin.y,
        ray_direction.y
    );
    float floor_distance = positive_plane_distance(
        0.0,
        ray_origin.y,
        ray_direction.y
    );
    float hit_distance = math::min(
        back_distance,
        math::min(
            left_distance,
            math::min(
                right_distance,
                math::min(ceiling_distance, floor_distance)
            )
        )
    );
    float3 hit_point = ray_origin + hit_distance * ray_direction;
    float normalised_window_x = saturate(hit_point.x / safe_room_width);
    float normalised_window_y = saturate(hit_point.y / safe_room_height);
    float full_depth_coordinate = saturate(
        -hit_point.z / safe_total_room_depth
    );
    float middle_v = tile_size * (1.0 + normalised_window_y);
    float middle_u = tile_size * (1.0 + normalised_window_x);
    float distance_tolerance = room_map_epsilon();
    bool hits_back = back_distance <= hit_distance + distance_tolerance;
    bool hits_left = !hits_back
        && left_distance <= hit_distance + distance_tolerance;
    bool hits_right = !hits_back
        && !hits_left
        && right_distance <= hit_distance + distance_tolerance;
    bool hits_ceiling = !hits_back
        && !hits_left
        && !hits_right
        && ceiling_distance <= hit_distance + distance_tolerance;
    float2 atlas_coordinate = hits_back
        ? float2(middle_u, middle_v)
        : hits_left
        ? float2(tile_size * full_depth_coordinate, middle_v)
        : hits_right
        ? float2(tile_size * (3.0 - full_depth_coordinate), middle_v)
        : hits_ceiling
        ? float2(middle_u, tile_size * (3.0 - full_depth_coordinate))
        : float2(middle_u, tile_size * full_depth_coordinate);
} in float3(atlas_coordinate.x, atlas_coordinate.y, hit_distance);

// Slice controls operate after projection into normalised room-face space so
// artists can reposition content without altering the physical aperture frame.
float2 transform_slice_coordinate(
    float2 hit_coordinate,
    float2 offset,
    float2 scale
)
{
    return float2(
        hit_coordinate.x * scale.x + offset.x,
        hit_coordinate.y * scale.y + offset.y
    );
}

// Embed one physical aperture sample into the classifier's shared room box.
// Front portals span room X; corner side portals span room depth instead.
float3 shared_aperture_position(
    float3 physical_position,
    bool depth_aligned_portal,
    float side_axis_direction,
    float3 room_scale,
    float room_extent,
    float room_width,
    float room_height,
    float mapped_room_depth,
    float2 window_shift,
    float2 aperture_scale,
    float2 window_aperture_offset
)
{
    float3 scaled_position = physical_position * room_scale * room_extent;
    float horizontal_control = window_aperture_offset.x + window_shift.x;
    float vertical_position = scaled_position.y * aperture_scale.y
        + 0.5 * room_height
        + (window_aperture_offset.y + window_shift.y) * room_height;
    float front_position_x = scaled_position.x * aperture_scale.x
        + 0.5 * room_width
        + horizontal_control * room_width;
    float side_position_z =
        (scaled_position.z + 0.5 * mapped_room_depth) * aperture_scale.x
        - 0.5 * mapped_room_depth
        + side_axis_direction * horizontal_control * mapped_room_depth;

    return depth_aligned_portal
        ? float3(
            scaled_position.x + 0.5 * room_width,
            vertical_position,
            side_position_z
        )
        : float3(front_position_x, vertical_position, scaled_position.z);
}

// The four slice tiles occupy the unused corners of the 3x3 cross atlas.
float2 slice_atlas_coordinate(
    float2 local_coordinate,
    float2 tile_origin
)
{
    float tile_size = 1.0 / 3.0;

    return tile_origin + local_coordinate * tile_size;
}

bool point_is_in_room_extent(
    float3 point,
    float room_width,
    float room_height
)
{
    return point.x >= 0.0
        && point.x <= room_width
        && point.y >= 0.0
        && point.y <= room_height;
}

bool coordinate_x_is_in_aperture_interval(
    float coordinate_x,
    float minimum_u,
    float maximum_u
)
{
    return minimum_u >= 0.0
        && maximum_u >= minimum_u
        && coordinate_x >= minimum_u
        && coordinate_x <= maximum_u;
}

bool coordinate_is_in_primary_aperture_intervals(
    float2 coordinate,
    float4 aperture_minimum_u,
    float4 aperture_maximum_u
)
{
    return coordinate.y >= 0.0
        && coordinate.y <= 1.0
        && (
            coordinate_x_is_in_aperture_interval(
                coordinate.x,
                aperture_minimum_u.x,
                aperture_maximum_u.x
            )
            || coordinate_x_is_in_aperture_interval(
                coordinate.x,
                aperture_minimum_u.y,
                aperture_maximum_u.y
            )
            || coordinate_x_is_in_aperture_interval(
                coordinate.x,
                aperture_minimum_u.z,
                aperture_maximum_u.z
            )
            || coordinate_x_is_in_aperture_interval(
                coordinate.x,
                aperture_minimum_u.w,
                aperture_maximum_u.w
            )
        );
}

bool coordinate_is_in_unit_tile(float2 coordinate)
{
    return coordinate.x >= 0.0
        && coordinate.x <= 1.0
        && coordinate.y >= 0.0
        && coordinate.y <= 1.0;
}

float slice_opacity(
    float4 sample,
    bool enabled,
    bool is_visible
)
{
    return enabled && is_visible ? saturate(sample.w) : 0.0;
}

// Keep slice-source eligibility together when it crosses the sampling seam.
// The controls affect only emission; colour, alpha, and occlusion remain owned
// by the normal slice-composition path.
struct room_emission_controls
{
    bool enabled;
    bool slice_1_enabled;
    bool slice_2_enabled;
    bool slice_3_enabled;
    bool slice_4_enabled;
    float threshold;
    float softness;
};

// Slice composition owns exactly four atlas lookups. It returns an emission
// contribution separately so source eligibility never changes base colour or
// opacity. The caller performs the fifth lookup for the selected room face.
struct room_slice_composite
{
    color colour;
    color emission_colour;
    float room_transmittance;
    float front_exit_coverage;
};

room_slice_composite composite_room_slices(
    uniform texture_2d room_atlas,
    int variant_index,
    float2 slice_1_coordinate,
    float2 slice_2_coordinate,
    float2 slice_3_coordinate,
    float2 slice_4_coordinate,
    bool enable_slice_1,
    bool enable_slice_2,
    bool enable_slice_3,
    bool enable_slice_4,
    room_emission_controls emission,
    bool front_exit_slice_1_is_visible,
    bool front_exit_slice_2_is_visible,
    bool front_exit_slice_3_is_visible,
    bool front_exit_slice_4_is_visible,
    bool slice_1_is_visible,
    bool slice_2_is_visible,
    bool slice_3_is_visible,
    bool slice_4_is_visible
) = let {
    float4 slice_1 = tex::lookup_float4(
        room_atlas,
        udim_atlas_coordinate(
            slice_atlas_coordinate(slice_1_coordinate, float2(0.0, 0.0)),
            variant_index
        ),
        tex::wrap_clip,
        tex::wrap_clip
    );
    float4 slice_2 = tex::lookup_float4(
        room_atlas,
        udim_atlas_coordinate(
            slice_atlas_coordinate(
                slice_2_coordinate,
                float2(0.0, 2.0 / 3.0)
            ),
            variant_index
        ),
        tex::wrap_clip,
        tex::wrap_clip
    );
    float4 slice_3 = tex::lookup_float4(
        room_atlas,
        udim_atlas_coordinate(
            slice_atlas_coordinate(
                slice_3_coordinate,
                float2(2.0 / 3.0, 2.0 / 3.0)
            ),
            variant_index
        ),
        tex::wrap_clip,
        tex::wrap_clip
    );
    float4 slice_4 = tex::lookup_float4(
        room_atlas,
        udim_atlas_coordinate(
            slice_atlas_coordinate(slice_4_coordinate, float2(2.0 / 3.0, 0.0)),
            variant_index
        ),
        tex::wrap_clip,
        tex::wrap_clip
    );
    float front_exit_slice_1_opacity = slice_opacity(
        slice_1,
        enable_slice_1,
        front_exit_slice_1_is_visible
    );
    float front_exit_slice_2_opacity = slice_opacity(
        slice_2,
        enable_slice_2,
        front_exit_slice_2_is_visible
    );
    float front_exit_slice_3_opacity = slice_opacity(
        slice_3,
        enable_slice_3,
        front_exit_slice_3_is_visible
    );
    float front_exit_slice_4_opacity = slice_opacity(
        slice_4,
        enable_slice_4,
        front_exit_slice_4_is_visible
    );
    float front_exit_transmittance =
        (1.0 - front_exit_slice_1_opacity)
        * (1.0 - front_exit_slice_2_opacity)
        * (1.0 - front_exit_slice_3_opacity)
        * (1.0 - front_exit_slice_4_opacity);
    float slice_1_opacity = slice_opacity(
        slice_1,
        enable_slice_1,
        slice_1_is_visible
    );
    float slice_2_opacity = slice_opacity(
        slice_2,
        enable_slice_2,
        slice_2_is_visible
    );
    float slice_3_opacity = slice_opacity(
        slice_3,
        enable_slice_3,
        slice_3_is_visible
    );
    float slice_4_opacity = slice_opacity(
        slice_4,
        enable_slice_4,
        slice_4_is_visible
    );
    float slice_2_transmittance = 1.0 - slice_1_opacity;
    float slice_3_transmittance = slice_2_transmittance
        * (1.0 - slice_2_opacity);
    float slice_4_transmittance = slice_3_transmittance
        * (1.0 - slice_3_opacity);
    float room_transmittance = slice_4_transmittance
        * (1.0 - slice_4_opacity);
    color slice_1_colour = color(slice_1.x, slice_1.y, slice_1.z);
    color slice_2_colour = color(slice_2.x, slice_2.y, slice_2.z);
    color slice_3_colour = color(slice_3.x, slice_3.y, slice_3.z);
    color slice_4_colour = color(slice_4.x, slice_4.y, slice_4.z);
    color composited_colour = slice_1_colour * slice_1_opacity
        + slice_2_colour * slice_2_opacity * slice_2_transmittance
        + slice_3_colour * slice_3_opacity * slice_3_transmittance
        + slice_4_colour * slice_4_opacity * slice_4_transmittance;
    float slice_1_emission_mask = room_emission_mask(
        slice_1_colour,
        emission.enabled && emission.slice_1_enabled,
        emission.threshold,
        emission.softness
    );
    float slice_2_emission_mask = room_emission_mask(
        slice_2_colour,
        emission.enabled && emission.slice_2_enabled,
        emission.threshold,
        emission.softness
    );
    float slice_3_emission_mask = room_emission_mask(
        slice_3_colour,
        emission.enabled && emission.slice_3_enabled,
        emission.threshold,
        emission.softness
    );
    float slice_4_emission_mask = room_emission_mask(
        slice_4_colour,
        emission.enabled && emission.slice_4_enabled,
        emission.threshold,
        emission.softness
    );
    // Every slice still occludes deeper emitters even when its own emission
    // flag is disabled. This prevents a non-emissive opaque prop from leaking
    // the luminous wall or slice behind it.
    color composited_emission_colour =
        slice_1_colour * slice_1_opacity * slice_1_emission_mask
        + slice_2_colour * slice_2_opacity * slice_2_transmittance
            * slice_2_emission_mask
        + slice_3_colour * slice_3_opacity * slice_3_transmittance
            * slice_3_emission_mask
        + slice_4_colour * slice_4_opacity * slice_4_transmittance
            * slice_4_emission_mask;
} in room_slice_composite(
    composited_colour,
    composited_emission_colour,
    room_transmittance,
    saturate(1.0 - front_exit_transmittance)
);

// Public artist material. Geometry identity and direct room-space mappings are
// supplied by named OpenUSD primvars; camera_position_world is updated by the
// runtime bridge and is never inferred from state::direction().
export material room_map(
    uniform bool enable_opacity = true,
    uniform texture_2d room_atlas = texture_2d(),
    uniform int room_variant_count = 1,
    uniform int variation_seed = 0,
    float3 camera_position_world = float3(0.0),
    float room_depth = 1.0,
    float room_uniform_scale = 1.0,
    float2 window_shift = float2(0.0),
    float2 window_aperture_scale = float2(1.0),
    float2 window_aperture_offset = float2(0.0),
    bool enable_slice_1 = true,
    bool enable_slice_2 = true,
    bool enable_slice_3 = true,
    bool enable_slice_4 = true,
    float slice_1_depth_percent = 20.0,
    float slice_2_depth_percent = 40.0,
    float slice_3_depth_percent = 60.0,
    float slice_4_depth_percent = 80.0,
    float2 slice_1_offset = float2(0.0),
    float2 slice_2_offset = float2(0.0),
    float2 slice_3_offset = float2(0.0),
    float2 slice_4_offset = float2(0.0),
    float2 slice_1_scale = float2(1.0),
    float2 slice_2_scale = float2(1.0),
    float2 slice_3_scale = float2(1.0),
    float2 slice_4_scale = float2(1.0),
    float glass_roughness = 0.1,
    float glass_reflectivity = 0.04,
    color glass_tint = color(1.0),
    float glass_transmission = 1.0,
    color fallback_colour = color(1.0, 0.0, 1.0),
    bool enable_emission = false,
    bool emission_slice_1 = true,
    bool emission_slice_2 = true,
    bool emission_slice_3 = true,
    bool emission_slice_4 = true,
    float emission_strength = 1.0,
    float emission_threshold = 0.8,
    float emission_softness = 0.1
) = let {
    // Select one deterministic UDIM interior before any texture lookup.
    int room_id = nvidia::support_definitions::data_lookup_int(
        "roomID",
        0
    );
    int variant_index = select_room_variant(
        room_id,
        variation_seed,
        room_variant_count
    );
    // Decode the compact classifier contract. The integer part stores the
    // width/depth atlas family and portal_mode distinguishes front from side
    // portals while retaining a float3 primvar supported by the MDL runtime.
    float3 room_position =
        nvidia::support_definitions::data_lookup_float3(
        "ormsRoomPositionWorld",
        float3(0.0)
    );
    float safe_room_extent = positive_extent(room_uniform_scale);
    float3 room_parameters =
        nvidia::support_definitions::data_lookup_float3(
            "ormsRoomParameters",
            float3(11.0, 0.0, 0.0)
        );
    int encoded_room_dimensions = int(room_parameters.x + 0.5);
    int derived_room_size = encoded_room_dimensions / 10;
    int derived_room_depth_size = encoded_room_dimensions % 10;
    float derived_slice_start_depth = room_parameters.y;
    float portal_mode = room_parameters.z;
    bool mapping_is_valid = math::abs(portal_mode) > 0.5;
    bool depth_aligned_portal = math::abs(portal_mode) > 1.5;
    float side_axis_direction = portal_mode < 0.0 ? -1.0 : 1.0;
    float3 derived_room_axis_u =
        nvidia::support_definitions::data_lookup_float3(
            "ormsRoomAxisU",
            float3(1.0, 0.0, 0.0)
        );
    float3 derived_room_axis_v =
        nvidia::support_definitions::data_lookup_float3(
            "ormsRoomAxisV",
            float3(0.0, 1.0, 0.0)
        );
    float3 derived_physical_normal =
        nvidia::support_definitions::data_lookup_float3(
            "ormsPhysicalNormal",
            float3(0.0, 0.0, 1.0)
        );
    float3 derived_room_scale =
        nvidia::support_definitions::data_lookup_float3(
            "ormsRoomScale",
            float3(1.0)
        );
    float3 derived_map_position =
        nvidia::support_definitions::data_lookup_float3(
            "ormsRoomMapPosition",
            float3(0.0)
        );
    float3 primary_aperture_minimum_u_012 =
        nvidia::support_definitions::data_lookup_float3(
            "ormsPrimaryApertureMinU012",
            float3(0.0, -1.0, -1.0)
        );
    float3 primary_aperture_maximum_u_012 =
        nvidia::support_definitions::data_lookup_float3(
            "ormsPrimaryApertureMaxU012",
            float3(1.0, -1.0, -1.0)
        );
    float3 primary_aperture_u_3 =
        nvidia::support_definitions::data_lookup_float3(
            "ormsPrimaryApertureU3",
            float3(-1.0, -1.0, 0.0)
        );
    float4 primary_aperture_minimum_u = float4(
        primary_aperture_minimum_u_012.x,
        primary_aperture_minimum_u_012.y,
        primary_aperture_minimum_u_012.z,
        primary_aperture_u_3.x
    );
    float4 primary_aperture_maximum_u = float4(
        primary_aperture_maximum_u_012.x,
        primary_aperture_maximum_u_012.y,
        primary_aperture_maximum_u_012.z,
        primary_aperture_u_3.y
    );
    float aperture_mask_offset_u =
        nvidia::support_definitions::data_lookup_float(
            "ormsApertureMaskOffsetU",
            0.0
        );
    // Clamp all derived dimensions before they influence room-space scaling.
    int active_room_size = derived_room_size;
    int active_room_depth_size = derived_room_depth_size;
    float3 safe_room_scale = float3(
        positive_extent(derived_room_scale.x),
        positive_extent(derived_room_scale.y),
        positive_extent(derived_room_scale.z)
    );
    float safe_room_width = safe_room_extent * float(active_room_size);
    float safe_room_height = safe_room_extent;
    float base_room_depth = positive_extent(room_depth)
        * safe_room_extent
        * float(active_room_depth_size);
    float bay_extension_depth =
        math::max(derived_slice_start_depth, 0.0) * safe_room_extent;
    float slice_start_depth = bay_extension_depth;
    float slice_depth_span = base_room_depth;
    bool slice_depth_range_is_valid =
        slice_depth_span > room_map_epsilon();
    bool frame_is_valid = mapping_is_valid
        && room_depth > room_map_epsilon();
    // Construct the shared world-to-room frame. Both camera and shaded point
    // must enter the same basis or the parallax ray drifts under stage motion.
    float3 tangent_u = math::normalize(derived_room_axis_u);
    float3 tangent_v = math::normalize(derived_room_axis_v);
    float3 physical_normal_world = math::normalize(
        derived_physical_normal
    );
    float3 room_normal = math::normalize(math::cross(tangent_u, tangent_v));
    float3 surface_position_world = state::transform_point(
        state::coordinate_internal,
        state::coordinate_world,
        state::position()
    );
    float physical_surface_cutout_opacity = depth_aligned_portal
        ? 1.0
        : physical_aperture_cutout_opacity(
            camera_position_world,
            surface_position_world,
            physical_normal_world
        );
    float3 camera_from_room = camera_position_world - room_position;
    float3 surface_from_room = surface_position_world - room_position;
    float3 camera_position_room = float3(
        math::dot(camera_from_room, tangent_u),
        math::dot(camera_from_room, tangent_v),
        math::dot(camera_from_room, room_normal)
    );
    float3 surface_position_room = float3(
        math::dot(surface_from_room, tangent_u),
        math::dot(surface_from_room, tangent_v),
        math::dot(surface_from_room, room_normal)
    );
    float2 safe_aperture_scale = float2(
        positive_extent(window_aperture_scale.x),
        positive_extent(window_aperture_scale.y)
    );
    float3 ray_vector_room = surface_position_room - camera_position_room;
    float3 ray_direction =
        math::normalize(ray_vector_room * safe_room_scale);
    // Map the current physical roomUV sample directly into the classifier's
    // shared room coordinates; MDL does not reconstruct scene adjacency.
    float3 shared_ray_origin = shared_aperture_position(
        derived_map_position,
        depth_aligned_portal,
        side_axis_direction,
        safe_room_scale,
        safe_room_extent,
        safe_room_width,
        safe_room_height,
        safe_room_extent * float(active_room_depth_size),
        window_shift,
        safe_aperture_scale,
        window_aperture_offset
    );
    float3 ray_origin = shared_ray_origin;
    float3 aperture_mask_scaled_position =
        (derived_map_position + float3(aperture_mask_offset_u, 0.0, 0.0))
        * safe_room_scale * safe_room_extent;
    float3 aperture_mask_ray_origin = float3(
        aperture_mask_scaled_position.x + 0.5 * safe_room_width,
        aperture_mask_scaled_position.y + 0.5 * safe_room_height,
        aperture_mask_scaled_position.z
    );
    // Faceted bays add a portal throat before the rectangular room. Reject a
    // ray that cannot enter that throat instead of leaking a room through walls.
    bool has_bay_extension = bay_extension_depth > room_map_epsilon();
    bool bay_ray_points_inward = ray_direction.z < -room_map_epsilon();
    float throat_projection_distance = has_bay_extension
        && bay_ray_points_inward
        ? math::max(
            (-bay_extension_depth - ray_origin.z) / ray_direction.z,
            0.0
        )
        : 0.0;
    float3 throat_ray_origin =
        ray_origin + throat_projection_distance * ray_direction;
    bool throat_entry_is_valid = has_bay_extension
        ? bay_ray_points_inward
            && point_is_in_room_extent(
                throat_ray_origin,
                safe_room_width,
                safe_room_height
            )
        : true;
    // Trace one analytic room hit. Corner side portals also test whether an
    // outward ray exits through a real opening on the primary facade.
    float3 room_trace = trace_room_cross(
        ray_origin,
        ray_direction,
        safe_room_width,
        safe_room_height,
        bay_extension_depth,
        base_room_depth
    );
    float2 room_atlas_coordinate = float2(room_trace.x, room_trace.y);
    float room_hit_distance = room_trace.z;
    bool front_exit_ray_is_valid = depth_aligned_portal
        && ray_direction.z > room_map_epsilon();
    float front_exit_distance = front_exit_ray_is_valid
        ? positive_plane_distance(
            0.0,
            aperture_mask_ray_origin.z,
            ray_direction.z
        )
        : room_map_far_distance();
    float3 front_exit_point =
        aperture_mask_ray_origin + front_exit_distance * ray_direction;
    bool front_exit_is_open = front_exit_ray_is_valid
        && point_is_in_room_extent(
            front_exit_point,
            safe_room_width,
            safe_room_height
        );
    float2 front_exit_coordinate = float2(
        front_exit_point.x / safe_room_width,
        front_exit_point.y / safe_room_height
    );
    bool front_exit_hits_primary_aperture = front_exit_is_open
        && coordinate_is_in_primary_aperture_intervals(
            front_exit_coordinate,
            primary_aperture_minimum_u,
            primary_aperture_maximum_u
        );
    float visible_room_limit_distance = front_exit_hits_primary_aperture
        ? math::min(room_hit_distance, front_exit_distance)
        : room_hit_distance;
    // This is the single room-face lookup. The same variant index is passed to
    // all four slice lookups below, preserving the five-lookup material budget.
    float4 room_sample = tex::lookup_float4(
        room_atlas,
        udim_atlas_coordinate(room_atlas_coordinate, variant_index),
        tex::wrap_clip,
        tex::wrap_clip
    );
    color sampled_room_colour = color(
        room_sample.x,
        room_sample.y,
        room_sample.z
    );
    color room_colour = frame_is_valid
        ? sampled_room_colour
        : fallback_colour;
    // Convert artist percentages into physical room depths after any bay
    // extension, then intersect all four planes with the same view ray.
    float slice_1_depth = slice_start_depth
        + slice_depth_span * saturate(slice_1_depth_percent / 100.0);
    float slice_2_depth = slice_start_depth
        + slice_depth_span * saturate(slice_2_depth_percent / 100.0);
    float slice_3_depth = slice_start_depth
        + slice_depth_span * saturate(slice_3_depth_percent / 100.0);
    float slice_4_depth = slice_start_depth
        + slice_depth_span * saturate(slice_4_depth_percent / 100.0);
    float slice_1_distance = slice_1_depth <= room_map_epsilon()
        ? 0.0
        : positive_plane_distance(
            -slice_1_depth,
            ray_origin.z,
            ray_direction.z
        );
    float slice_2_distance = slice_2_depth <= room_map_epsilon()
        ? 0.0
        : positive_plane_distance(
            -slice_2_depth,
            ray_origin.z,
            ray_direction.z
        );
    float slice_3_distance = slice_3_depth <= room_map_epsilon()
        ? 0.0
        : positive_plane_distance(
            -slice_3_depth,
            ray_origin.z,
            ray_direction.z
        );
    float slice_4_distance = slice_4_depth <= room_map_epsilon()
        ? 0.0
        : positive_plane_distance(
            -slice_4_depth,
            ray_origin.z,
            ray_direction.z
        );
    float3 slice_1_hit_point =
        ray_origin + slice_1_distance * ray_direction;
    float3 slice_2_hit_point =
        ray_origin + slice_2_distance * ray_direction;
    float3 slice_3_hit_point =
        ray_origin + slice_3_distance * ray_direction;
    float3 slice_4_hit_point =
        ray_origin + slice_4_distance * ray_direction;
    float2 slice_1_local_coordinate = transform_slice_coordinate(
        float2(
            slice_1_hit_point.x / safe_room_width,
            slice_1_hit_point.y / safe_room_height
        ),
        slice_1_offset,
        slice_1_scale
    );
    float2 slice_2_local_coordinate = transform_slice_coordinate(
        float2(
            slice_2_hit_point.x / safe_room_width,
            slice_2_hit_point.y / safe_room_height
        ),
        slice_2_offset,
        slice_2_scale
    );
    float2 slice_3_local_coordinate = transform_slice_coordinate(
        float2(
            slice_3_hit_point.x / safe_room_width,
            slice_3_hit_point.y / safe_room_height
        ),
        slice_3_offset,
        slice_3_scale
    );
    float2 slice_4_local_coordinate = transform_slice_coordinate(
        float2(
            slice_4_hit_point.x / safe_room_width,
            slice_4_hit_point.y / safe_room_height
        ),
        slice_4_offset,
        slice_4_scale
    );
    // Front-exit visibility prevents slices from appearing across the solid
    // facade between real corner apertures. Normal visibility also clips each
    // projected slice to the room and to its own unit tile.
    bool front_exit_slice_1_is_visible = front_exit_hits_primary_aperture
        && slice_depth_range_is_valid
        && slice_1_distance <= front_exit_distance
        && point_is_in_room_extent(
            slice_1_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_1_local_coordinate);
    bool front_exit_slice_2_is_visible = front_exit_hits_primary_aperture
        && slice_depth_range_is_valid
        && slice_2_distance <= front_exit_distance
        && point_is_in_room_extent(
            slice_2_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_2_local_coordinate);
    bool front_exit_slice_3_is_visible = front_exit_hits_primary_aperture
        && slice_depth_range_is_valid
        && slice_3_distance <= front_exit_distance
        && point_is_in_room_extent(
            slice_3_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_3_local_coordinate);
    bool front_exit_slice_4_is_visible = front_exit_hits_primary_aperture
        && slice_depth_range_is_valid
        && slice_4_distance <= front_exit_distance
        && point_is_in_room_extent(
            slice_4_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_4_local_coordinate);
    bool slice_1_is_visible = throat_entry_is_valid
        && slice_depth_range_is_valid
        && slice_1_distance <= visible_room_limit_distance
        && point_is_in_room_extent(
            slice_1_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_1_local_coordinate);
    bool slice_2_is_visible = throat_entry_is_valid
        && slice_depth_range_is_valid
        && slice_2_distance <= visible_room_limit_distance
        && point_is_in_room_extent(
            slice_2_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_2_local_coordinate);
    bool slice_3_is_visible = throat_entry_is_valid
        && slice_depth_range_is_valid
        && slice_3_distance <= visible_room_limit_distance
        && point_is_in_room_extent(
            slice_3_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_3_local_coordinate);
    bool slice_4_is_visible = throat_entry_is_valid
        && slice_depth_range_is_valid
        && slice_4_distance <= visible_room_limit_distance
        && point_is_in_room_extent(
            slice_4_hit_point,
            safe_room_width,
            safe_room_height
        )
        && coordinate_is_in_unit_tile(slice_4_local_coordinate);
    room_emission_controls emission_controls = room_emission_controls(
        enable_emission,
        emission_slice_1,
        emission_slice_2,
        emission_slice_3,
        emission_slice_4,
        emission_threshold,
        emission_softness
    );
    // Composite near-to-far slice coverage once, then reuse its transmittance
    // for both the interior colour and the binary physical-aperture cutout.
    room_slice_composite slice_composite = composite_room_slices(
        room_atlas,
        variant_index,
        slice_1_local_coordinate,
        slice_2_local_coordinate,
        slice_3_local_coordinate,
        slice_4_local_coordinate,
        enable_slice_1,
        enable_slice_2,
        enable_slice_3,
        enable_slice_4,
        emission_controls,
        front_exit_slice_1_is_visible,
        front_exit_slice_2_is_visible,
        front_exit_slice_3_is_visible,
        front_exit_slice_4_is_visible,
        slice_1_is_visible,
        slice_2_is_visible,
        slice_3_is_visible,
        slice_4_is_visible
    );
    color composited_slice_colour = slice_composite.colour;
    color composited_slice_emission_colour =
        slice_composite.emission_colour;
    float room_transmittance = slice_composite.room_transmittance;
    float front_exit_slice_coverage =
        slice_composite.front_exit_coverage;
    float slice_coverage = saturate(1.0 - room_transmittance);
    bool front_exit_has_slice_surface = front_exit_slice_coverage >= 0.5;
    // Invalid source mappings must remain visible as fallback_colour. Running
    // aperture cutouts without a runtime frame can otherwise erase the proxy.
    float production_cutout_opacity = !frame_is_valid
        ? 1.0
        : physical_surface_cutout_opacity < 0.5
        ? 0.0
        : front_exit_hits_primary_aperture
        ? front_exit_has_slice_surface ? 1.0 : 0.0
        : 1.0;
    float room_cutout_opacity = enable_opacity
        ? production_cutout_opacity
        : 1.0;
    color front_exit_slice_colour = composited_slice_colour
        / math::max(slice_coverage, room_map_epsilon());
    color composited_room_colour = front_exit_hits_primary_aperture
        ? front_exit_slice_colour
        : room_colour * room_transmittance + composited_slice_colour;
    // A single proxy surface cannot refract into absent room geometry. Model
    // transmission as interior visibility through a tinted Fresnel coating;
    // the binary portal cutout remains an independent geometry decision.
    float safe_glass_roughness = saturate(glass_roughness);
    float squared_glass_roughness =
        safe_glass_roughness * safe_glass_roughness;
    float safe_glass_reflectivity = saturate(glass_reflectivity);
    float safe_glass_transmission = saturate(glass_transmission);
    color tinted_room_colour = composited_room_colour * glass_tint;
    color glass_base_colour =
        glass_tint * (1.0 - safe_glass_transmission)
        + tinted_room_colour * safe_glass_transmission;
    bsdf room_surface = df::diffuse_reflection_bsdf(
        tint: glass_base_colour
    );
    bsdf glass_reflection = df::microfacet_ggx_smith_bsdf(
        roughness_u: squared_glass_roughness,
        roughness_v: squared_glass_roughness,
        tint: color(1.0),
        mode: df::scatter_reflect
    );
    // Roughness controls only the GGX lobe width. Keep its normal-incidence
    // strength explicit so a sharp reflection can be diagnosed independently
    // from tint and artistic transmission.
    bsdf room_behind_glass = df::custom_curve_layer(
        normal_reflectivity: safe_glass_reflectivity,
        grazing_reflectivity: 1.0,
        exponent: 5.0,
        weight: 1.0,
        layer: glass_reflection,
        base: room_surface,
        normal: state::normal()
    );
    color room_face_emission_colour = room_colour * room_emission_mask(
        room_colour,
        emission_controls.enabled,
        emission_controls.threshold,
        emission_controls.softness
    );
    color front_exit_slice_emission_colour =
        composited_slice_emission_colour
        / math::max(slice_coverage, room_map_epsilon());
    // A front portal is empty unless an authored depth slice covers it. Never
    // turn the proxy glass or an uncovered portal into an emissive surface.
    bool emission_hits_interior_surface =
        !front_exit_hits_primary_aperture || front_exit_has_slice_surface;
    color composited_emission_colour = front_exit_hits_primary_aperture
        ? front_exit_slice_emission_colour
        : room_face_emission_colour * room_transmittance
            + composited_slice_emission_colour;
    color emission_source_colour =
        frame_is_valid && emission_hits_interior_surface
        ? composited_emission_colour
        : color(0.0);
    color visible_room_emission = emission_source_colour
        * glass_tint * safe_glass_transmission;
} in material(
    geometry: material_geometry(
        cutout_opacity: room_cutout_opacity
    ),
    surface: material_surface(
        scattering: room_behind_glass,
        emission: material_emission(
            df::diffuse_edf(),
            intensity: visible_room_emission * emission_strength
        )
    )
);
